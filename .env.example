# Required for AI commands: uncomment one provider and set an explicit model.
# HIREME_LLM_PROVIDER=ollama
# HIREME_LLM_MODEL=qwen3:8b

# Provider credentials/endpoints. Only the selected provider is validated.
OLLAMA_BASE_URL=http://localhost:11434/v1
# MISTRAL_API_KEY=
# OPENAI_API_KEY=

# Runtime data and optional remote tracing.
HIREME_HOME=.hireme
# HIREME_DEFAULT_PROFILE_PATH=/absolute/path/to/profile
HIREME_LOGFIRE_ENABLED=false
HIREME_LOGFIRE_INCLUDE_CONTENT=false
# LOGFIRE_TOKEN=
